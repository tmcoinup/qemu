-fn rm_identity_driver_supported(version: &str) -> bool {
-    version.trim().starts_with("535.")
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum RmIdentityAbi {
+    R535,
+    R580_65_05,
+    R580_159_01,
+}
+
+fn parse_mdev_framebuffer_mb(description: &str) -> Option<u32> {
+    let value = description
+        .split(',')
+        .map(str::trim)
+        .find_map(|field| field.strip_prefix("framebuffer="))?
+        .trim();
+    let digits_len = value
+        .find(|character: char| !character.is_ascii_digit())
+        .unwrap_or(value.len());
+    if digits_len == 0 {
+        return None;
+    }
+    let amount = value[..digits_len].parse::<u32>().ok()?;
+    match value[digits_len..].trim() {
+        "" | "M" | "m" => Some(amount),
+        "G" | "g" => amount.checked_mul(1024),
+        "K" | "k" => amount.checked_add(1023).map(|value| value / 1024),
+        _ => None,
+    }
+}
+
+fn mdev_framebuffer_mb(mdev_uuid: &str) -> Option<u32> {
+    let description_path = PathBuf::from(MDEV_DEVICES_PATH)
+        .join(mdev_uuid)
+        .join("mdev_type/description");
+    fs::read_to_string(description_path)
+        .ok()
+        .and_then(|description| parse_mdev_framebuffer_mb(&description))
+}
+
+fn rm_identity_field_write_allowed(
+    abi: RmIdentityAbi,
+    index: u32,
+    framebuffer_mb: Option<u32>,
+) -> bool {
+    // On R580, rewriting a V100 guest's physical HBM2 RAM type to the
+    // catalog GDDR5 value keeps the device at Code 0 but deadlocks Windows
+    // shutdown for V100X-2Q. V100X-1Q was independently verified at Code 0
+    // and exits normally with the same RAM_TYPE write. Keep that proven 1 GiB
+    // path, but fail closed for 2 GiB and unknown tiers. BUS_WIDTH and
+    // MEMORYINFO_VENDOR_ID remain independently safe, and R535 is unchanged.
+    !matches!(abi, RmIdentityAbi::R580_65_05 | RmIdentityAbi::R580_159_01)
+        || index != NV2080_CTRL_FB_INFO_INDEX_RAM_TYPE
+        || framebuffer_mb == Some(1024)
+}
+
+fn rm_identity_driver_abi(version: &str) -> Option<RmIdentityAbi> {
+    let version = version.trim();
+    if version.starts_with("535.") {
+        Some(RmIdentityAbi::R535)
+    } else if version == "580.65.05" {
+        Some(RmIdentityAbi::R580_65_05)
+    } else if version == "580.159.01" {
+        Some(RmIdentityAbi::R580_159_01)
+    } else {
+        None
+    }
 }
 
