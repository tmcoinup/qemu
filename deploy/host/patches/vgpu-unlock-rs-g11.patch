+fn merge_rm_control_trace_config(
+    trace: &mut RmControlTraceConfig,
+    config_override: &VgpuProfileOverride,
+) {
+    if let Some(enabled) = config_override.rm_control_trace {
+        trace.enabled = enabled;
+    }
+    if let Some(commands) = config_override.rm_control_trace_commands.as_ref() {
+        trace.commands = commands.iter().map(|command| command.0).collect();
+    }
+    if let Some(limit) = config_override.rm_control_trace_limit {
+        trace.limit = Some(limit);
+    }
+}
+
+fn configure_rm_control_trace(
+    vgpu_type: &str,
+    mdev_uuid: Option<String>,
+    config_overrides: &ProfileOverridesConfig,
+    source: &str,
+) {
+    let mut trace = RmControlTraceConfig::default();
+    if let Some(config_override) = config_overrides.profile.get(vgpu_type) {
+        merge_rm_control_trace_config(&mut trace, config_override);
+    }
+    if let Some(mdev_uuid) = mdev_uuid.as_ref() {
+        if let Some(config_override) = config_overrides.mdev.get(mdev_uuid) {
+            merge_rm_control_trace_config(&mut trace, config_override);
+        }
+    }
+
+    trace.commands.sort_unstable();
+    trace.commands.dedup();
+    let limit = trace
+        .limit
+        .unwrap_or(DEFAULT_RM_CONTROL_TRACE_LIMIT)
+        .min(MAX_RM_CONTROL_TRACE_LIMIT);
+    let enabled = trace.enabled && limit > 0;
+
+    {
+        let mut state = RM_CONTROL_TRACE.lock();
+        let same_mdev = state.mdev_uuid == mdev_uuid;
+        state.mdev_uuid = mdev_uuid.clone();
+        state.commands = trace.commands;
+        state.limit = limit;
+        if !same_mdev {
+            state.count = 0;
+            state.limit_reported = false;
+        } else if state.count < state.limit {
+            // A later profile-level merge may raise the limit.  Keep the
+            // already captured start-up events without leaving the tracer in
+            // its old "limit reached" state.
+            state.limit_reported = false;
+        }
+    }
+    RM_CONTROL_TRACE_ENABLED.store(enabled, Ordering::Release);
+
+    if enabled {
+        info!(
+            "G11_RM_TRACE configured mdev={} source={} limit={} command_filter={}",
+            mdev_uuid.as_deref().unwrap_or("unknown"),
+            source,
+            limit,
+            if RM_CONTROL_TRACE.lock().commands.is_empty() {
+                "all"
+            } else {
+                "selected"
+            }
+        );
+    }
+}
+
+fn configure_rm_control_trace_for_mdev(mdev_uuid: Uuid) {
+    let config_overrides = match load_overrides() {
+        Ok(overrides) => overrides,
+        Err(_) => {
+            RM_CONTROL_TRACE_ENABLED.store(false, Ordering::Release);
+            return;
+        }
+    };
+    let config_overrides: ProfileOverridesConfig = match toml::from_str(&config_overrides) {
+        Ok(config) => config,
+        Err(e) => {
+            error!("Failed to decode config for early RM trace: {}", e);
+            RM_CONTROL_TRACE_ENABLED.store(false, Ordering::Release);
+            return;
+        }
+    };
+
+    // The start-data command supplies the mdev UUID before vGPU manager asks
+    // for the profile.  Enabling the per-mdev trace here captures the static
+    // FB/GR/MC queries that occur before the profile override callback.
+    configure_rm_control_trace(
+        "",
+        Some(mdev_uuid.to_string()),
+        &config_overrides,
+        "mdev-start",
+    );
+    configure_rm_identity_override_for_mdev(mdev_uuid, &config_overrides);
+}
+
+fn configure_rm_identity_override_for_mdev(
+    mdev_uuid: Uuid,
+    config_overrides: &ProfileOverridesConfig,
+) {
+    let mdev_uuid = mdev_uuid.to_string();
+    let driver_version = fs::read_to_string(NVIDIA_MODULE_VERSION_PATH);
+    if !driver_version
+        .as_deref()
+        .is_ok_and(rm_identity_driver_supported)
+    {
+        let reported_version = driver_version
+            .as_deref()
+            .map(str::trim)
+            .unwrap_or("unavailable");
+        {
+            let mut state = RM_IDENTITY_OVERRIDE.lock();
+            state.mdev_uuid = Some(mdev_uuid.clone());
+            state.config = RmIdentityOverrideConfig::default();
+        }
+        RM_IDENTITY_OVERRIDE_ENABLED.store(false, Ordering::Release);
+        error!(
+            "G11_RM_IDENTITY disabled mdev={} unsupported_driver={} expected=535.x",
+            mdev_uuid, reported_version
+        );
+        return;
+    }
+    let mut config = config_overrides
+        .mdev
+        .get(mdev_uuid.as_str())
+        .map(|profile| RmIdentityOverrideConfig {
+            fb_bus_width: profile.rm_fb_bus_width,
+            fb_ram_type: profile.rm_fb_ram_type,
+            fb_memory_vendor: profile.rm_fb_memory_vendor,
+        })
+        .unwrap_or_default();
+
+    if let Some(value) = config.fb_bus_width {
+        const VALID_BUS_WIDTHS: &[u32] = &[32, 64, 96, 128, 160, 192, 256, 320, 352, 384, 448, 512];
+        if !VALID_BUS_WIDTHS.contains(&value) {
+            error!(
+                "G11_RM_IDENTITY ignoring invalid fb_bus_width={} mdev={}",
+                value, mdev_uuid
+            );
+            config.fb_bus_width = None;
+        }
+    }
+    if let Some(value) = config.fb_ram_type {
+        const VALID_RAM_TYPES: &[u32] = &[
+            0x0, 0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0x8, 0x9, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11,
+            0x12, 0x13, 0x14,
+        ];
+        if !VALID_RAM_TYPES.contains(&value) {
+            error!(
+                "G11_RM_IDENTITY ignoring invalid fb_ram_type={:#x} mdev={}",
+                value, mdev_uuid
+            );
+            config.fb_ram_type = None;
+        }
+    }
+    if let Some(value) = config.fb_memory_vendor {
+        const VALID_MEMORY_VENDORS: &[u32] =
+            &[0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0x8, 0x9, 0x0f, u32::MAX];
+        if !VALID_MEMORY_VENDORS.contains(&value) {
+            error!(
+                "G11_RM_IDENTITY ignoring invalid fb_memory_vendor={:#x} mdev={}",
+                value, mdev_uuid
+            );
+            config.fb_memory_vendor = None;
+        }
+    }
+
+    let enabled = config.enabled();
+    {
+        let mut state = RM_IDENTITY_OVERRIDE.lock();
+        state.mdev_uuid = Some(mdev_uuid.clone());
+        state.config = config;
+    }
+    RM_IDENTITY_OVERRIDE_ENABLED.store(enabled, Ordering::Release);
+
+    if enabled {
+        info!(
+            "G11_RM_IDENTITY configured mdev={} fb_bus_width={:?} fb_ram_type={:?} fb_memory_vendor={:?}",
+            mdev_uuid,
+            config.fb_bus_width,
+            config.fb_ram_type,
+            config.fb_memory_vendor
+        );
+    }
+}
+
+fn patch_rm_info_entry(
+    entries: &mut [RmInfoEntry],
+    list_size: u32,
+    index: u32,
+    value: u32,
+) -> Option<u32> {
+    let list_size = cmp::min(list_size as usize, entries.len());
+    entries
+        .iter_mut()
+        .take(list_size)
+        .find(|entry| entry.index == index)
+        .map(|entry| {
+            let old = entry.data;
+            entry.data = value;
+            old
+        })
+}
+
+unsafe fn apply_rm_identity_override(io_data: &mut Nvos54Parameters) {
+    if !RM_IDENTITY_OVERRIDE_ENABLED.load(Ordering::Acquire)
+        || io_data.cmd != NV2080_CTRL_CMD_FB_GET_INFO_V2
+    {
+        return;
+    }
+
+    if io_data.params.is_null()
+        || io_data.params_size as usize != mem::size_of::<Nv2080CtrlFbGetInfoV2Params>()
+    {
+        error!(
+            "G11_RM_IDENTITY refusing FB_GET_INFO_V2 size={} expected={}",
+            io_data.params_size,
+            mem::size_of::<Nv2080CtrlFbGetInfoV2Params>()
+        );
+        return;
+    }
+
+    let params: &mut Nv2080CtrlFbGetInfoV2Params = &mut *io_data.params.cast();
+    if params.fb_info_list_size as usize > params.fb_info_list.len() {
+        error!(
+            "G11_RM_IDENTITY refusing FB_GET_INFO_V2 list_size={} max={}",
+            params.fb_info_list_size,
+            params.fb_info_list.len()
+        );
+        return;
+    }
+
+    let state = RM_IDENTITY_OVERRIDE.lock();
+    let mdev_uuid = state.mdev_uuid.as_deref().unwrap_or("unknown");
+    for (field, index, value) in [
+        (
+            "fb_bus_width",
+            NV2080_CTRL_FB_INFO_INDEX_BUS_WIDTH,
+            state.config.fb_bus_width,
+        ),
+        (
+            "fb_ram_type",
+            NV2080_CTRL_FB_INFO_INDEX_RAM_TYPE,
+            state.config.fb_ram_type,
+        ),
+    ] {
+        let value = match value {
+            Some(value) => value,
+            None => continue,
+        };
+        match patch_rm_info_entry(
+            &mut params.fb_info_list,
+            params.fb_info_list_size,
+            index,
+            value,
+        ) {
+            Some(old) => info!(
+                "G11_RM_IDENTITY mdev={} cmd={:#010x} field={} index={:#04x} old={} new={} requested=true",
+                mdev_uuid, io_data.cmd, field, index, old, value
+            ),
+            None => info!(
+                "G11_RM_IDENTITY mdev={} cmd={:#010x} field={} index={:#04x} requested=false",
+                mdev_uuid, io_data.cmd, field, index
+            ),
+        }
+    }
+
+    if let Some(value) = state.config.fb_memory_vendor {
+        match patch_rm_info_entry(
+            &mut params.fb_info_list,
+            params.fb_info_list_size,
+            NV2080_CTRL_FB_INFO_INDEX_MEMORYINFO_VENDOR_ID,
+            value,
+        ) {
+            Some(old) => info!(
+                "G11_RM_IDENTITY mdev={} cmd={:#010x} field=fb_memory_vendor index={:#04x} old={} new={} requested=true",
+                mdev_uuid,
+                io_data.cmd,
+                NV2080_CTRL_FB_INFO_INDEX_MEMORYINFO_VENDOR_ID,
+                old,
+                value
+            ),
+            None => info!(
+                "G11_RM_IDENTITY mdev={} cmd={:#010x} field=fb_memory_vendor index={:#04x} requested=false manager_did_not_query=true",
+                mdev_uuid,
+                io_data.cmd,
+                NV2080_CTRL_FB_INFO_INDEX_MEMORYINFO_VENDOR_ID
+            ),
+        }
+    }
+}
+
+fn trace_rm_control(io_data: &Nvos54Parameters) {
+    if !RM_CONTROL_TRACE_ENABLED.load(Ordering::Acquire) {
+        return;
+    }
+
+    let event = {
+        let mut state = RM_CONTROL_TRACE.lock();
+        if !state.commands.is_empty() && state.commands.binary_search(&io_data.cmd).is_err() {
+            None
+        } else if state.count < state.limit {
+            state.count += 1;
+            Some((state.mdev_uuid.clone(), state.count, false, state.limit))
+        } else if !state.limit_reported {
+            state.limit_reported = true;
+            Some((state.mdev_uuid.clone(), state.count, true, state.limit))
+        } else {
+            None
+        }
+    };
+
+    if let Some((mdev_uuid, sequence, limit_reached, limit)) = event {
+        if limit_reached {
+            info!(
+                "G11_RM_TRACE limit reached mdev={} limit={}",
+                mdev_uuid.as_deref().unwrap_or("unknown"),
+                limit
+            );
+        } else {
+            info!(
+                "G11_RM_TRACE mdev={} seq={} pid={} cmd={:#010x} size={} status={:#010x} hclient={:#010x} hobject={:#010x} flags={:#010x}",
+                mdev_uuid.as_deref().unwrap_or("unknown"),
+                sequence,
+                process::id(),
+                io_data.cmd,
+                io_data.params_size,
+                io_data.status,
+                io_data.h_client,
+                io_data.h_object,
+                io_data.flags
+            );
+        }
+    }
 }
 
