/* nv_stream_relay.rc — Win32 VERSIONINFO so 任务管理器 / 资源管理器
 * 显示 NVIDIA-style metadata (CompanyName, FileDescription, etc.)
 * 而不是空白。值跟 GRID 538.33 (vGPU 16.4) 对齐。
 */
#include <winver.h>

1 VERSIONINFO
FILEVERSION    31,0,15,3833
PRODUCTVERSION 31,0,15,3833
FILEFLAGSMASK  0x3FL
FILEFLAGS      0x0L
FILEOS         0x40004L      /* VOS_NT_WINDOWS32 */
FILETYPE       0x1L          /* VFT_APP */
FILESUBTYPE    0x0L
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "CompanyName",      "NVIDIA Corporation"
            VALUE "FileDescription",  "NVIDIA Streaming Service"
            VALUE "FileVersion",      "31.0.15.3833"
            VALUE "InternalName",     "NvStreamSvc"
            VALUE "LegalCopyright",   "(C) NVIDIA Corporation. All rights reserved."
            VALUE "OriginalFilename", "NvStreamSvc.exe"
            VALUE "ProductName",      "NVIDIA Display Container"
            VALUE "ProductVersion",   "31.0.15.3833"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x0409, 0x04B0
    }
}
