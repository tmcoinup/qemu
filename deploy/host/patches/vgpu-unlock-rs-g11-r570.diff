+    // R570 V100X-1Q and V100X-2Q were independently verified at Code 0, without
+    // TDR/XID, and with normal shutdown both alone and in a mixed pool. R580
+    // remains fail-closed at 1Q because its 2Q rewrite deadlocked shutdown.
+    // BUS_WIDTH and MEMORYINFO_VENDOR_ID are independently safe; R535 is unchanged.
+    if index != NV2080_CTRL_FB_INFO_INDEX_RAM_TYPE {
+        return true;
+    }
+    match abi {
+        RmIdentityAbi::R535 => true,
+        RmIdentityAbi::R570_172_07 => matches!(framebuffer_mb, Some(1024 | 2048)),
+        RmIdentityAbi::R580_65_05 | RmIdentityAbi::R580_159_01 => framebuffer_mb == Some(1024),
+    }
 }
 
