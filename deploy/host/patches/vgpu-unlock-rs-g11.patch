+#[cfg(test)]
+mod g11_tests {
+    use std::mem;
+
+    use super::{
+        merge_rm_control_trace_config, patch_rm_info_entry, rm_identity_driver_supported,
+        Nv2080CtrlFbGetInfoV2Params, ProfileOverridesConfig, RmControlTraceConfig, RmInfoEntry,
+        NV2080_CTRL_FB_INFO_MAX_LIST_SIZE,
+    };
+
+    #[test]
+    fn mdev_rm_trace_settings_replace_profile_defaults() {
+        let overrides: ProfileOverridesConfig = toml::from_str(
+            r#"
+                [profile.nvidia-257]
+                rm_control_trace = true
+                rm_control_trace_commands = ["0x20801301", "0x20801201"]
+                rm_control_trace_limit = 100
+
+                [mdev."bcbed946-976f-467a-bd7d-01e181b1bee8"]
+                rm_control_trace_commands = ["0x20801701"]
+                rm_control_trace_limit = 250
+            "#,
+        )
+        .expect("trace configuration must parse");
+
+        let mut trace = RmControlTraceConfig::default();
+        merge_rm_control_trace_config(&mut trace, overrides.profile.get("nvidia-257").unwrap());
+        merge_rm_control_trace_config(
+            &mut trace,
+            overrides
+                .mdev
+                .get("bcbed946-976f-467a-bd7d-01e181b1bee8")
+                .unwrap(),
+        );
+
+        assert!(trace.enabled);
+        assert_eq!(trace.commands, vec![0x20801701]);
+        assert_eq!(trace.limit, Some(250));
+    }
+
+    #[test]
+    fn fb_get_info_v2_layout_matches_r535() {
+        assert_eq!(NV2080_CTRL_FB_INFO_MAX_LIST_SIZE, 0x36);
+        assert_eq!(mem::size_of::<RmInfoEntry>(), 8);
+        assert_eq!(mem::size_of::<Nv2080CtrlFbGetInfoV2Params>(), 436);
+    }
+
+    #[test]
+    fn rm_identity_is_gated_to_r535() {
+        assert!(rm_identity_driver_supported("535.161.05\n"));
+        assert!(!rm_identity_driver_supported("550.163.02\n"));
+        assert!(!rm_identity_driver_supported("unavailable"));
+    }
+
+    #[test]
+    fn rm_info_patch_honors_caller_list_size() {
+        let mut entries = [
+            RmInfoEntry {
+                index: 0x0b,
+                data: 256,
+            },
+            RmInfoEntry {
+                index: 0x0d,
+                data: 0x11,
+            },
+            RmInfoEntry {
+                index: 0x1c,
+                data: u32::MAX,
+            },
+        ];
+
+        assert_eq!(patch_rm_info_entry(&mut entries, 2, 0x0b, 128), Some(256));
+        assert_eq!(entries[0].data, 128);
+        assert_eq!(patch_rm_info_entry(&mut entries, 2, 0x1c, 1), None);
+        assert_eq!(entries[2].data, u32::MAX);
+        assert_eq!(
+            patch_rm_info_entry(&mut entries, 3, 0x1c, 1),
+            Some(u32::MAX)
+        );
+        assert_eq!(entries[2].data, 1);
+    }
+
