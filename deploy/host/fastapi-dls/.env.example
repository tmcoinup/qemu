# Token 中公布给 vGPU guest 的地址。只写 IP 或 DNS 名，不带协议和端口。
DLS_URL=

# Token 中公布的端口，以及 Docker 在本机监听的端口。
# 直接暴露容器时二者保持一致；经过反向代理时可以不同。
DLS_PORT=443
HOST_PORT=443

# Docker 监听地址。生产环境优先写 VPN/LAN 接口地址并配合防火墙白名单。
LISTEN_ADDRESS=0.0.0.0

# fastapi-dls 官方镜像版本。升级前先备份 state/ 并阅读上游兼容性说明。
DLS_IMAGE=collinwebdesigns/fastapi-dls:2.0.3
COMPOSE_PROJECT_NAME=fastapi-dls

TZ=UTC
LEASE_EXPIRE_DAYS=90
