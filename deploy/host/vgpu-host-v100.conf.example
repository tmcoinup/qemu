# Tesla V100 resource example for the validated vGPU 18.4/R570.172.07 path.
# Generate the real host file with configure-g11-vgpu-host.sh; do not copy an
# example BDF onto another machine.

# Replace auto with the complete BDF on a multi-GPU host.
VGPU_MGPU=auto

# vGPU 18.4 exposes and enables heterogeneous time-slice sizes on the tested
# V100 SXM2 16GB host. Mixed mode lets 1Q and 2Q coexist; both sizes and their
# coexistence passed the Windows/host error/reclaim quick validation.
VGPU_HOST_FB_MODE=mixed
VGPU_RESOURCE_PROFILE_1024='V100X-1Q'
VGPU_RESOURCE_PROFILE_2048='V100X-2Q'
VGPU_TOTAL_FB_MB=16384
VGPU_CAPACITY_CHECK=both

# Other reviewed prefixes:
#   PCIe 16 GiB : V100-1Q / V100-2Q
#   PCIe 32 GiB : V100D-1Q / V100D-2Q       (total 32768)
#   SXM2 32 GiB : V100DX-1Q / V100DX-2Q     (total 32768)
#   V100S 32 GiB: V100S-1Q / V100S-2Q       (total 32768)
#   FHHL 16 GiB : V100L-1Q / V100L-2Q

VGPU_CONSOLE_INTERVAL_US=0

# R570 uses the reviewed 460-byte FB_GET_INFO_V2 ABI. RAM_TYPE is rewritten
# only for exact 1024/2048 MiB instances; unknown framebuffer sizes are
# fail-closed. The V100 keeps its native vGPU capability while per-mdev name,
# FHD display identity and the guarded framebuffer identity stay required.
VGPU_MDEV_IDENTITY_MODE=required
VGPU_RM_FB_IDENTITY_MODE=required
SPOOF_MODE=B

# For a deliberately uniform pool, regenerate instead of hand-editing:
#   configure-g11-vgpu-host.sh --preset v100-sxm2-16gb --fb-mode equal \
#       --tier 1024 --gpu DDDD:BB:SS.F
