#include <windows.h>

1 RT_MANIFEST "vgpu_production_migration.manifest"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Local QEMU vGPU tools\0"
            VALUE "FileDescription", "Production-only vGPU driver migration\0"
            VALUE "FileVersion", "1.1.0.0\0"
            VALUE "InternalName", "VgpuProductionMigration\0"
            VALUE "OriginalFilename", "VgpuProductionMigration.exe\0"
            VALUE "ProductName", "QEMU vGPU production migration\0"
            VALUE "ProductVersion", "1.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
